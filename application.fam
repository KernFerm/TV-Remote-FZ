App(
    appid="tv_remote_fz",
    name="TV Remote FZ",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tv_remote_fz_app",
    sources=["tv_remote_fz.c", "tv_remote_core.c", "tv_remote_signal.c", "tv_remote_icons.c"],
